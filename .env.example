# Runtime application traffic: use Neon's pooled connection string (-pooler hostname).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Schema migrations: use the direct (non-pooled) connection string.
# Keep this separate from DATABASE_URL; never commit real credentials.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Maximum CAP XML payload accepted by ingestion endpoints (bytes).
CAP_MAX_PAYLOAD_BYTES=1048576

# Better Auth. Generate a unique secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
# Optional on Vercel Preview (Better Auth can infer the request origin).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend transactional email. Use a sender address verified in your Resend account.
RESEND_API_KEY="re_xxxxxxxxx"
AUTH_EMAIL_FROM="CivicRelay <security@example.org>"
